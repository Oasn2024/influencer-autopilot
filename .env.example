# Copy to .env.local and fill in. Never commit real values.

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Postgres (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autopilot

# Encryption keys for connected-account tokens.
# Format: id:base64key[,id:base64key]. Generate a key with: openssl rand -base64 32
# To rotate: append a new key, point CURRENT_KEY_ID at it, then run `npm run tokens:rotate`.
TOKEN_ENCRYPTION_KEYS=v1:REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32
TOKEN_ENCRYPTION_CURRENT_KEY_ID=v1

# Public URL of the app, used for OAuth redirect URIs (falls back to the request origin).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects /api/cron/run. Vercel Cron sends it automatically. Generate with: openssl rand -hex 32
CRON_SECRET=

# AI drafts go through the Vercel AI Gateway (OIDC on Vercel; set AI_GATEWAY_API_KEY locally).
# Creators pick Claude, GPT or Gemini in the AI Studio (list in src/lib/ai/models.ts).
# AI_MODEL is only the default for autopilot and API calls that don't name a model.
AI_MODEL=anthropic/claude-sonnet-5.5
AI_GATEWAY_API_KEY=

# AI images are stored in Vercel Blob so platforms can fetch them by URL.
# Connecting a Blob store to the project (Vercel > Storage) sets this automatically. Images stay off without it.
BLOB_READ_WRITE_TOKEN=

# Platform developer apps. Redirect URI for each: <NEXT_PUBLIC_APP_URL>/api/connect/<provider>/callback
# provider = x | linkedin | threads | meta  (meta covers Facebook Pages and Instagram business accounts)
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202510
THREADS_APP_ID=
THREADS_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
